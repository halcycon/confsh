#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
#   confsh                      interactive shell
#   confsh show interfaces      one operational command
#   confsh -s < script          run commands from stdin, stop at first error

RC=/usr/lib/confsh/confsh.bashrc

case "$1" in
-s)
	# shellcheck disable=SC2016
	exec bash -c '
		. "$0"
		n=0
		while IFS= read -r line; do
			n=$((n + 1))
			case $line in ""|"#"*) continue ;; esac
			eval "$line" || { echo "confsh: line $n failed: $line" >&2; builtin exit 1; }
		done
		builtin exit 0' "$RC"
	;;
-h|--help)
	sed -n '4,6s/^# //p' "$0"
	exit 0
	;;
"")
	exec bash --rcfile "$RC" -i
	;;
*)
	# shellcheck disable=SC2016
	exec bash -c '. "$0"; "$@"' "$RC" "$@"
	;;
esac
