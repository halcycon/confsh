#!/usr/bin/ucode -S
// SPDX-License-Identifier: MIT
// show firewall [zones|forwardings|rules]: committed firewall config as tables.
// The Section column is the path to use with set/delete.

import { fail, str, table } from 'confsh.util';
import * as tree from 'confsh.tree';

let what = ARGV[0];

if (what != null && index([ 'zones', 'forwardings', 'rules' ], what) < 0)
	fail(`Invalid command: show firewall ${what}`);

let secs = tree.load(require('uci').cursor(), 'firewall') ?? [];
let of_type = t => filter(secs, s => s.type == t);
let enabled = s => (s.opts.enabled == '0') ? 'no' : 'yes';
let first = true;

function section(title, headers, rows) {
	if (!first)
		print('\n');

	first = false;
	print(title, '\n');

	if (length(rows))
		table(headers, rows);
	else
		print('(none)\n');
}

if (what == null || what == 'zones') {
	let d = of_type('defaults')[0]?.opts ?? {};

	if (what == null)
		printf('Defaults: input %s, output %s, forward %s%s\n\n',
			str(d.input), str(d.output), str(d.forward),
			(d.flow_offloading == '1') ? ((d.flow_offloading_hw == '1') ? ', hardware offload' : ', software offload') : '');

	section('Zones', [ 'Section', 'Name', 'Networks', 'Input', 'Output', 'Forward', 'Masq' ],
		map(of_type('zone'), s => [
			`zone ${s.label}`, str(s.opts.name), str(s.opts.network),
			str(s.opts.input), str(s.opts.output), str(s.opts.forward),
			(s.opts.masq == '1') ? 'yes' : 'no'
		]));
}

if (what == null || what == 'forwardings')
	section('Forwardings', [ 'Section', 'From', 'To', 'Enabled' ],
		map(of_type('forwarding'), s => [
			`forwarding ${s.label}`, str(s.opts.src), str(s.opts.dest), enabled(s)
		]));

if (what == null || what == 'rules')
	section('Rules', [ 'Section', 'Name', 'From', 'To', 'Proto', 'Dest port', 'Target', 'Enabled' ],
		map(of_type('rule'), s => [
			`rule ${s.label}`, str(s.opts.name),
			s.opts.src ?? 'router', s.opts.dest ?? 'router',
			str(s.opts.proto), str(s.opts.dest_port), str(s.opts.target), enabled(s)
		]));
